    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
